# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add the same names under Project > Settings > Environment Variables, then Redeploy.
# Every variable is read on the server only. None of them may start with NEXT_PUBLIC_.

# Session signing key — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# One password hash per account that should be able to sign in.
# Generate: node scripts/hash-password.mjs "their-password"
AUTH_HASH_ADMIN=
AUTH_HASH_AKSHAR=
AUTH_HASH_ABHINAV=
AUTH_HASH_ADNAAN=
AUTH_HASH_BHUVAN=
AUTH_HASH_KAMIL=
AUTH_HASH_ANUSHA=
AUTH_HASH_MANISH=
AUTH_HASH_VINOD=
AUTH_HASH_CHAKRAVARTHI=

# Google Sheets bridge (server-side only — the browser never sees these).
# Deploy the Apps Script from Integrations > Google Sheets (Copy Apps Script), then paste its /exec URL here.
# Script version 1 shares work logs only; redeploy the version 2 script to share everything (docs/SHEETS_SETUP.md).
SHEETS_WEBAPP_URL=
# Shared secret. Set the same value as the Script Property AXORAA_TOKEN in Apps Script.
SHEETS_API_TOKEN=

# Marketing assistant (Claude, model claude-opus-5-5) behind /api/agents. Empty = the assistant shows "not configured".
# Needs Vercel Fluid compute for 300-second runs (docs/ASSISTANT.md).
ANTHROPIC_API_KEY=
# Optional. Assistant runs per person per hour, counted in memory on each server instance. Default 30.
AGENTS_RATE_LIMIT_PER_HOUR=

# Meta (Facebook Page, Lead Ads). Everything below is optional; see docs/META_SETUP.md.
# Graph API version used in every Meta URL. Default v27.0. Re-test Meta features after changing it.
META_GRAPH_VERSION=
# ID of the Business-type Meta app. Required for Meta.
META_APP_ID=
# App secret: signs appsecret_proof and checks the webhook X-Hub-Signature-256 header. Required for Meta.
META_APP_SECRET=
# Business Portfolio ID. Reference only for now.
META_BUSINESS_ID=
# System-user access token. Meta needs this or META_PAGE_ACCESS_TOKEN.
META_SYSTEM_USER_TOKEN=
# Expiry date of the system-user token, YYYY-MM-DD. Admins are warned 10 days before.
META_SYSTEM_USER_TOKEN_EXPIRES_AT=
# ID of the Axoraa Facebook Page. Required for Meta; webhook entries must match it.
META_PAGE_ID=
# Optional Page token. When empty, the server derives one from the system-user token (cached for an hour).
META_PAGE_ACCESS_TOKEN=
# Optional Instagram professional account ID. Status display only; Instagram publishing is not built yet.
META_IG_USER_ID=
# Optional ad account ID (act_...). Kept for future ads reporting, which is not built yet.
META_AD_ACCOUNT_ID=
# Random string of 32+ characters, used only for the webhook GET handshake. Lead Ads also need Sheets v2.
META_WEBHOOK_VERIFY_TOKEN=
# Comma-separated Lead Ad form IDs checked by "Fetch missed leads" (last 7 days).
META_LEADGEN_FORM_IDS=
# Must be 'true' (with Meta configured) before the hub publishes or schedules Facebook Page posts.
META_PUBLISH_ENABLED=false
